# Get a key at https://aistudio.google.com/apikey and copy this file to .env
GEMINI_API_KEY=

# Optional. If a key is rate-limited, the backend tries the next one immediately.
# Comma-separated list is read first:
# GEMINI_API_KEYS=<key-1>,<key-2>,<key-3>
# Numbered keys are added after that list, skipping duplicates:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=

GEMMA_MODEL=gemma-4-31b-it
GEMMA_THINKING=high

# small fits a 2 GB host; medium handles Gujarati better but needs more RAM
WHISPER_MODEL=small

# Comma-separated site origins allowed to call this API, besides localhost.
# Vercel preview URLs (*.vercel.app) are already allowed.
# CORS_ORIGINS=https://your-app.vercel.app
